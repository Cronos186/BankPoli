# ---------------------------------------------------------------------------
# BankPoli - API REST de transferencias interbancarias
# Copie este archivo como .env y ajuste los valores segun su entorno.
#
# Desarrollo:
#   Base de datos en Docker : npm run db:up   (y DB_DRIVER=postgres mas abajo)
#   Sin Docker              : DB_DRIVER=memory
#   API                     : npm run start:dev
#
# Produccion (ver README.md, seccion 3.4):
#   npm ci && npm run build
#   NODE_ENV=production node dist/main.js
#   Con NODE_ENV=production la variable JWT_SECRET es obligatoria.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# Origenes permitidos por CORS (separados por coma). Use * solo en desarrollo.
CORS_ORIGINS=http://localhost:4200,http://localhost:5173

# ---------------------------------------------------------------------------
# Seguridad / JWT
# ---------------------------------------------------------------------------
# Obligatorio en produccion. En desarrollo, si se omite, se usa un valor local.
JWT_SECRET=cambie-este-secreto-por-uno-largo-y-aleatorio-1234567890
# Vigencia del token en segundos (3600 = 1 hora)
JWT_EXPIRES_IN_SECONDS=3600

# ---------------------------------------------------------------------------
# Persistencia del nucleo transaccional (core legacy simulado)
# ---------------------------------------------------------------------------
# postgres -> usa el nucleo legacy simulado en PostgreSQL (docker compose up -d)
# memory   -> usa un nucleo legacy en memoria (util para demo sin Docker y pruebas)
DB_DRIVER=memory

DB_HOST=localhost
DB_PORT=5433
DB_USER=bankpoli
DB_PASSWORD=bankpoli
DB_NAME=bankpoli
DB_SCHEMA=legacy
DB_SSL=false
DB_POOL_MAX=10
